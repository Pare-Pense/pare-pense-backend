generator client {
    provider = "prisma-client"
    output   = "../src/generated/prisma"
}

datasource db {
    provider = "postgresql"
}

model Usuario {
    id String @id @default(uuid())
    nome String
    dataNascimento DateTime @db.Date
    email String @unique
    senha String
    rendaMensal Decimal @db.Decimal(10, 2)
    limiteMensal Decimal @db.Decimal(10, 2)
    createdAt DateTime @default(now())
    despesas Despesa[]
}

model Despesa {
    id String @id @default(uuid())
    nome String
    categoria Categoria
    data DateTime @db.Date
    valor Decimal @db.Decimal(10, 2)
    horario DateTime @db.Time
    idUsuario String
    usuario Usuario @relation(fields: [idUsuario], references: [id])
}

enum Categoria {
    ALIMENTACAO
    LAZER
    TRANSPORTE
    COMPRAS
    CONTAS
    OUTROS
}
